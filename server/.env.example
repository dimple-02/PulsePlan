# ==============================================================================
# PulsePlan Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production'
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/pulseplan_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/pulseplan_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pulseplan_db

# Allowed Frontend Client Origin for CORS
# In production on Render, set this to your Vercel frontend URL: https://pulse-plan.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Cookies (Minimum 32 characters in production)
JWT_SECRET=pulseplan_jwt_secret_dev_key_2026_production_safe_string_min_32_chars

# Optional OTP Hashing Salt (Falls back to JWT_SECRET if unset)
OTP_SALT=pulseplan_otp_salt_secret_key_2026_min_32_characters

# ==============================================================================
# SMTP Email Service Configuration (Required for Live Email Delivery on Render)
# ==============================================================================
# If SMTP_HOST and SMTP_USER are omitted in development, PulsePlan automatically
# creates an Ethereal test SMTP account and outputs live email preview URLs to the console.
# In production on Render, configure one of the following SMTP providers:

# ------------------------------------------------------------------------------
# Option A: Brevo (Formerly Sendinblue) - Recommended Free Tier (300 emails/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@domain.com
# SMTP_PASS=your-smtp-master-key
# SMTP_SECURE=false
# EMAIL_FROM=PulsePlan <no-reply@yourdomain.com>

# ------------------------------------------------------------------------------
# Option B: Resend (SMTP Relay)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_1234567890abcdef
# SMTP_SECURE=true
# EMAIL_FROM=PulsePlan <updates@yourdomain.com>

# ------------------------------------------------------------------------------
# Option C: SendGrid
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your_api_key_here
# SMTP_SECURE=false
# EMAIL_FROM=PulsePlan <no-reply@yourdomain.com>

# ------------------------------------------------------------------------------
# Option D: Gmail SMTP (Requires 2-Step Verification & 16-character App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=youraccount@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SECURE=true
# EMAIL_FROM=PulsePlan <youraccount@gmail.com>

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=PulsePlan <no-reply@pulseplan.io>

# ==============================================================================
# Cloudinary Configuration for Attachments (Optional)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
