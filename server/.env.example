# ==============================================================================
# PulsePlan Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' | 'production'
NODE_ENV=development

# MongoDB Connection String
# For Local MongoDB: mongodb://127.0.0.1:27017/pulseplan_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/pulseplan_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pulseplan_db

# Allowed Frontend Client Origin for CORS
# In production on Render, set this to your Vercel frontend URL: https://pulse-plan.vercel.app
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Cookies (Minimum 32 characters in production)
JWT_SECRET=pulseplan_jwt_secret_dev_key_2026_production_safe_string_min_32_chars

# Optional OTP Hashing Salt (Falls back to JWT_SECRET if unset)
OTP_SALT=pulseplan_otp_salt_secret_key_2026_min_32_characters

# ==============================================================================
# Production Email Configuration (Brevo HTTPS Transactional API - Port 443)
# ==============================================================================
# NOTE: Render Free strictly blocks outbound SMTP ports 25, 465, and 587.
# In production on Render, do NOT use SMTP. Instead, provide your Brevo API Key
# to deliver all emails over secure HTTPS (port 443) via Brevo's official API:
# https://api.brevo.com/v3/smtp/email
#
# Obtain your API key from: Brevo Dashboard -> SMTP & API -> API Keys -> Generate a new API key
BREVO_API_KEY=your_brevo_v3_api_key_here

# Verified Sender Email Address (Configured & verified in your Brevo account)
# Example: PulsePlan <your-verified-sender@yourdomain.com>
EMAIL_FROM=PulsePlan <no-reply@pulseplan.io>

# ==============================================================================
# Local Development SMTP Fallback (Optional)
# ==============================================================================
# If BREVO_API_KEY is omitted in local development, PulsePlan automatically creates
# an ephemeral Ethereal test SMTP account and outputs live email preview URLs to the console.
# Optionally, you can specify custom local SMTP credentials below:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ==============================================================================
# Cloudinary Configuration for Attachments (Optional)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
